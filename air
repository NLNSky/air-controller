local draggingSpeed = false

local function updateSpeed(x)
    local alpha = math.clamp((x-speedBar.AbsolutePosition.X)/speedBar.AbsoluteSize.X,0,1)
    State.Speed = math.floor(alpha*100+0.5)
    speedLabel.Text = "Speed: "..State.Speed
    speedFill.Size = UDim2.new(alpha,0,1,0)
    speedKnob.Position = UDim2.new(alpha,0,0.5,0)
end

speedBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSpeed = true
        updateSpeed(i.Position.X)
    end
end)

speedKnob.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSpeed = true
    end
end)

UIS.InputChanged:Connect(function(i)
    if draggingSpeed and i.UserInputType == Enum.UserInputType.MouseMovement then
        updateSpeed(i.Position.X)
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSpeed = false
    end
end)

local draggingPanel=false
local panelStart,mouseStart
title.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then draggingPanel=true; mouseStart=i.Position; panelStart=panel.Position end end)
UIS.InputChanged:Connect(function(i)
    if draggingPanel and i.UserInputType==Enum.UserInputType.MouseMovement then
        local d=i.Position-mouseStart
        panel.Position=UDim2.new(panelStart.X.Scale,panelStart.X.Offset+d.X,panelStart.Y.Scale,panelStart.Y.Offset+d.Y)
        panelToggle.Position=UDim2.new(
            panel.Position.X.Scale,
            panel.Position.X.Offset+panel.AbsoluteSize.X+4,
            panel.Position.Y.Scale,
            panel.Position.Y.Offset
        )
    end
end)
UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then draggingPanel=false end end)

UIS.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode==Enum.KeyCode.W then State.Forward=true end
    if i.KeyCode==Enum.KeyCode.S then State.Back=true end
    if i.KeyCode==Enum.KeyCode.A then State.Left=true end
    if i.KeyCode==Enum.KeyCode.D then State.Right=true end
end)
UIS.InputEnded:Connect(function(i)
    if i.KeyCode==Enum.KeyCode.W then State.Forward=false end
    if i.KeyCode==Enum.KeyCode.S then State.Back=false end
    if i.KeyCode==Enum.KeyCode.A then State.Left=false end
    if i.KeyCode==Enum.KeyCode.D then State.Right=false end
end)

RunService.RenderStepped:Connect(function(dt)
    if not State.Frozen then return end
    local root=getRoot()
    if not root then return end
    root.Anchored=true
    local camera=workspace.CurrentCamera
    local forward=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
    local right=Vector3.new(camera.CFrame.RightVector.X,0,camera.CFrame.RightVector.Z)
    if forward.Magnitude>0 then forward=forward.Unit end
    if right.Magnitude>0 then right=right.Unit end
    local move=Vector3.zero
    if State.Forward then move+=forward end
    if State.Back then move-=forward end
    if State.Right then move+=right end
    if State.Left then move-=right end
    if move.Magnitude>0 then move=move.Unit*State.Speed*dt end
    local p = root.Position + move
    local verticalMove = (State.Vertical or 0) * State.Speed * dt
    local y = p.Y + verticalMove

    root.CFrame = CFrame.new(
        p.X,
        y,
        p.Z
    ) * CFrame.Angles(0,math.rad(root.Orientation.Y),0)
end)

