local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getGroundY(position)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(position + Vector3.new(0,500,0), Vector3.new(0,-1000,0), params)
    return result and result.Position.Y or position.Y
end

local function setFrozen(enabled)
    State.Frozen = enabled
    local root = getRoot()
    if not root then return end
    root.Anchored = enabled
    if enabled then
        local p = root.Position
        root.CFrame = CFrame.new(p.X, p.Y, p.Z) * CFrame.Angles(0, math.rad(root.Orientation.Y), 0)
    end
end

